+"""Small, offline tests for ERA5 atmospheric preprocessing.
+
+Tests by Faezeh Maghsoodifar, 2026.
+"""
+
+import numpy as np
+import pandas as pd
+import pytest
+import xarray as xr
+
+from CrocoDash.raw_data_access.datasets import era5_atmos
+
+
+def test_specific_humidity_from_dewpoint():
+    q = era5_atmos.specific_humidity_from_dewpoint(
+        np.asarray([293.15]), np.asarray([101325.0])
+    )
+    assert q[0] == pytest.approx(0.01448, rel=2.0e-3)
+
+
+def test_prepare_small_synthetic_archive(tmp_path):
+    root = tmp_path / "d633000"
+    month = "200808"
+    lat = np.asarray([10.0, 11.0])
+    lon = np.asarray([20.0, 21.0])
+    time = pd.date_range("2008-08-02", periods=6, freq="h")
+    values = {"u10": 5.0, "v10": 2.0, "t2m": 300.0, "d2m": 295.0, "msl": 100000.0}
+    units = {"u10": "m s**-1", "v10": "m s**-1", "t2m": "K", "d2m": "K", "msl": "Pa"}
+
+    for key, value in values.items():
+        collection, code, variable = era5_atmos.RDA_FIELDS[key]
+        folder = root / collection / month
+        folder.mkdir(parents=True, exist_ok=True)
+        data = np.full((6, 2, 2), value, dtype="float32")
+        dataset = xr.Dataset(
+            {variable: (("time", "latitude", "longitude"), data)},
+            coords={"time": time, "latitude": lat, "longitude": lon},
+        )
+        dataset[variable].attrs["units"] = units[key]
+        dataset.to_netcdf(folder / f"test.{code}.nc")
+
+    initial = pd.DatetimeIndex(["2008-08-02T00:00:00"])
+    hour = np.arange(6)
+    rate_fields = (
+        ("swdn", 500.0, "W m**-2"),
+        ("lwdn", 350.0, "W m**-2"),
+        ("precip", 0.001, "kg m**-2 s**-1"),
+    )
+    for key, value, unit in rate_fields:
+        collection, code, variable = era5_atmos.RDA_FIELDS[key]
+        folder = root / collection / month
+        folder.mkdir(parents=True, exist_ok=True)
+        data = np.full((1, 6, 2, 2), value, dtype="float32")
+        dataset = xr.Dataset(
+            {
+                variable: (
+                    (
+                        "forecast_initial_time",
+                        "forecast_hour",
+                        "latitude",
+                        "longitude",
+                    ),
+                    data,
+                )
+            },
+            coords={
+                "forecast_initial_time": initial,
+                "forecast_hour": hour,
+                "latitude": lat,
+                "longitude": lon,
+            },
+        )
+        dataset[variable].attrs["units"] = unit
+        dataset.to_netcdf(folder / f"test.{code}.nc")
+
+    output = tmp_path / "era5.nc"
+    files = era5_atmos.prepare_rda_era5_atmosphere(
+        "2008-08-02T00",
+        "2008-08-02T05",
+        output,
+        rda_root=root,
+        chunks={"time": 2, "forecast_initial_time": 1},
+    )
+    result = era5_atmos.validate_prepared_era5(output, "2008-08-02T00", "2008-08-02T05")
+    assert set(files) == set(era5_atmos.OUTPUT_FIELDS)
+    assert result.sizes == {"time": 6, "lat": 2, "lon": 2}
+    assert float(result.q2m.mean()) == pytest.approx(0.01646, rel=2.0e-3)
+    result.close()
+
+
+def test_write_scrip_grid(tmp_path):
+    path = era5_atmos.write_scrip_grid(
+        lon=np.asarray([0.0, 1.0]),
+        lat=np.asarray([-1.0, 0.0, 1.0]),
+        path=tmp_path / "grid_scrip.nc",
+    )
+    with xr.open_dataset(path) as grid:
+        assert grid.sizes == {"grid_rank": 2, "grid_size": 6, "grid_corners": 4}
+        assert np.all(grid.grid_imask == 1)
